# Copy to .env and fill in. Never commit .env.

# External APIs
NEWSAPI_KEY=
FOOTBALL_DATA_KEY=

# Kafka (host access; containers use kafka:19092)
KAFKA_BOOTSTRAP=localhost:9092

# Spark consumers: where to start reading when no checkpoint exists (earliest | latest)
STARTING_OFFSETS=earliest

# Local root for outputs and checkpoints (venv runs; the Docker "app" service
# overrides it with hdfs://namenode:8020/scaledatapipe)
DATA_ROOT=./data

# Optional tuning
# SPORT_DAYS_BACK=14               # sport producer window: past days (final scores)
# SPORT_DAYS_AHEAD=14              # ... and upcoming days (fixtures)
# SILVER_DEDUP_WINDOW=7 days       # Silver drops duplicates arriving within this window
# EXECUTOR_GRACE_SECONDS=120       # streaming job exits (and restarts) after this long without executors

# Airflow: generate these with `python3 scripts/init_env.py` (random values, written to .env only)
AIRFLOW_DB_PASSWORD=
AIRFLOW_FERNET_KEY=
AIRFLOW_SECRET_KEY=
AIRFLOW_ADMIN_PASSWORD=

# Spark cluster mode (compose "cluster" profile); empty = local mode
# SPARK_MASTER_URL=spark://spark-master:7077
